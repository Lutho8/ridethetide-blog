# Environment Variables

# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git

# --- Ahrefs ---
AHREFS_API_TOKEN=your_ahrefs_api_token_here
AHREFS_PROJECT_ID=ridethetide-site

# --- Google Search Console ---
GSC_CLIENT_ID=your_gsc_oauth_client_id
GSC_CLIENT_SECRET=your_gsc_oauth_client_secret
GSC_REFRESH_TOKEN=your_gsc_refresh_token
GSC_SITE_URL=https://blog.ridethetide.site/

# --- Gong ---
GONG_ACCESS_KEY=your_gong_access_key
GONG_SECRET_KEY=your_gong_secret_key

# --- Intercom ---
INTERCOM_ACCESS_TOKEN=your_intercom_access_token
INTERCOM_APP_ID=your_intercom_app_id

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_TEAM_ID=your_slack_team_id

# --- OpenAI / Anthropic (AI Content Helper) ---
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Brand Radar ---
BRAND_RADAR_API_KEY=your_brand_radar_key

# --- Feedly (Firehose) ---
FEEDLY_API_KEY=your_feedly_api_key

# --- Email (Firehose Digest) ---
FIREHOSE_EMAIL=lutho@ridethetide.site

# --- Cloudflare (Deployment) ---
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
