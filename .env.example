# Ride The Tide Content OS - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ============================================
# AI Content Helper (Kimi / Moonshot AI)
# ============================================
KIMI_API_KEY=sk-your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k

# ============================================
# Google Search Console API
# ============================================
# Get these from Google Cloud Console > APIs & Services > Credentials
GSC_CLIENT_ID=your-client-id.apps.googleusercontent.com
GSC_CLIENT_SECRET=your-client-secret
# Run: node scripts/gsc-auth.cjs to get this after setting CLIENT_ID and CLIENT_SECRET
GSC_REFRESH_TOKEN=your-refresh-token
# Your site URL in GSC (must match exactly)
GSC_SITE_URL=https://blog.ridethetide.site/

# ============================================
# Ahrefs API (Optional - requires paid plan)
# ============================================
AHREFS_API_TOKEN=your-ahrefs-api-token

# ============================================
# Brand Radar / AI Search Visibility (Optional)
# ============================================
# Add when available
