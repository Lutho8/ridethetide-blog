---
import Layout from '../layouts/Layout.astro';

const guides = [
  {
    title: 'Peptide Reconstitution: The Math Nobody Teaches You',
    slug: 'reconstitution-guide',
    category: 'Research Methods',
    description: 'Step-by-step guide to reconstituting peptides correctly. BAC water calculations, concentration tables, and common mistakes.',
    level: 'Beginner',
    time: '8 min read',
  },
  {
    title: 'Injection Techniques for Peptides',
    slug: 'injection-techniques',
    category: 'Research Methods',
    description: 'Subcutaneous, intramuscular, and intranasal administration. Needle selection, site rotation, and safety protocols.',
    level: 'Beginner',
    time: '12 min read',
  },
  {
    title: 'Bloodwork Before, During, and After Peptide Protocols',
    slug: 'bloodwork-guide',
    category: 'Safety & Science',
    description: 'What to test, when to test, and how to interpret results. Complete panel recommendations for SA researchers.',
    level: 'Intermediate',
    time: '14 min read',
  },
  {
    title: 'The Complete BPC-157 Guide',
    slug: 'bpc-157-guide',
    category: 'Peptide Deep Dives',
    description: 'Mechanism of action, dosing protocols, cycling strategies, and South African sourcing considerations.',
    level: 'Intermediate',
    time: '12 min read',
  },
  {
    title: 'TB-500 Complete Guide',
    slug: 'tb-500-guide',
    category: 'Peptide Deep Dives',
    description: 'Actin regulation, wound healing, cardiac repair, dosing protocols, and South African sourcing.',
    level: 'Intermediate',
    time: '12 min read',
  },
  {
    title: 'CJC-1295 + Ipamorelin: The Growth Hormone Stack',
    slug: 'cjc-ipamorelin-stack',
    category: 'Protocol Guides',
    description: 'Synergistic GH secretagogue protocol. Dosing schedules, timing, and bloodwork monitoring.',
    level: 'Intermediate',
    time: '15 min read',
  },
  {
    title: 'Fat Loss Protocol: A 6-Week Case Study',
    slug: 'fat-loss-protocol-case-study',
    category: 'Case Studies',
    description: 'Data-driven first-person account using CJC-1295, Ipamorelin, and lifestyle modifications.',
    level: 'Advanced',
    time: '15 min read',
  },
  {
    title: 'GLP-1 Comparison: Semaglutide vs Tirzepatide vs Retatrutide',
    slug: 'glp1-comparison',
    category: 'Peptide Deep Dives',
    description: 'Head-to-head comparison of mechanisms, efficacy, side effects, dosing, and SA availability.',
    level: 'Advanced',
    time: '18 min read',
  },
  {
    title: 'GHK-Cu Complete Guide',
    slug: 'ghk-cu-guide',
    category: 'Peptide Deep Dives',
    description: 'Gene expression modulation, collagen synthesis, wound healing, anti-aging, hair growth, and dosing.',
    level: 'Intermediate',
    time: '12 min read',
  },
  {
    title: 'South African Peptide Sourcing Guide',
    slug: 'sa-peptide-sourcing',
    category: 'South African Context',
    description: 'Local suppliers, international import, customs, quality verification, and price comparisons in ZAR.',
    level: 'Beginner',
    time: '15 min read',
  },
  {
    title: 'SAHPRA Peptide Regulations Explained',
    slug: 'sahpra-peptide-regulations',
    category: 'South African Context',
    description: 'SAHPRA scheduling, import regulations, and what "for research purposes" means in South Africa.',
    level: 'Beginner',
    time: '10 min read',
  },
];
---

<Layout title="Protocol Guides | Ride The Tide Research" description="Step-by-step peptide research guides. Reconstitution, injection, storage, bloodwork, and complete protocols for South African researchers.">
  <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
    <div class="mb-12">
      <h1 class="text-3xl font-bold text-slate-900 mb-4">Protocol Guides</h1>
      <p class="text-lg text-slate-600 max-w-3xl">
        Practical, step-by-step guides for every stage of peptide research. 
        From your first reconstitution to advanced stacking protocols.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {guides.map(guide => (
        <article class="article-card">
          <div class="p-6">
            <div class="flex items-center gap-3 mb-3">
              <span class="tag-pill">{guide.category}</span>
              <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                guide.level === 'Beginner' ? 'bg-green-100 text-green-700' :
                guide.level === 'Intermediate' ? 'bg-amber-100 text-amber-700' :
                'bg-red-100 text-red-700'
              }`}>{guide.level}</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-2">
              <a href={`/blog/${guide.slug}/`} class="hover:text-teal-600 transition">
                {guide.title}
              </a>
            </h2>
            <p class="text-sm text-slate-600 mb-4">{guide.description}</p>
            <div class="flex items-center gap-2 text-xs text-slate-500">
              <span>{guide.time}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
