---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found | Ride The Tide Research" description="The page you're looking for doesn't exist. Explore our peptide research database and protocol guides.">
  <div class="mx-auto max-w-2xl px-4 py-24 lg:px-8 text-center">
    <h1 class="text-6xl font-bold text-slate-900 mb-4">404</h1>
    <p class="text-xl text-slate-600 mb-8">
      This page doesn't exist — but our research database does.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-full bg-teal-600 px-6 py-3 font-semibold text-white hover:bg-teal-700 transition">
        Go Home
      </a>
      <a href="/blog" class="rounded-full border border-slate-300 px-6 py-3 font-semibold text-slate-700 hover:border-slate-400 transition">
        Browse Research
      </a>
      <a href="/peptides" class="rounded-full border border-slate-300 px-6 py-3 font-semibold text-slate-700 hover:border-slate-400 transition">
        Peptide Database
      </a>
    </div>
  </div>
</Layout>
